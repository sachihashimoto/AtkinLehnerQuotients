.DS_Store

# Generated by the driver scripts in scripts/ (gen_genus_models.m,
# pointsearch_*.m and run_pointsearch_g8.sh write here).  Nothing under
# outputs/ is tracked.
outputs/

# Test transcripts written by tests/run.sh; regenerated on every run.
tests/logs/

# Local agent/tool state, not part of the project.
.claude/

# Talk drafts and slide decks.  Local working material, deliberately not part of
# the public paper companion.
talks/

# LaTeX build products next to the notes (and next to drafts in the root).
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
/*.log
/*.out
notes/*.log
notes/*.out
